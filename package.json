{
  "name": "onework-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "사내 메신저 통합 솔루션 — 공유 웹 UI(www) + Electron(PC) + Capacitor(모바일)",
  "scripts": {
    "web": "python -m http.server 5173 --directory www",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dist": "npm --prefix desktop run dist",
    "mobile:install": "npm --prefix mobile install",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:android": "npm --prefix mobile run android:open"
  }
}
