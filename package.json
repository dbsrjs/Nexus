{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "개발자를 위한 커뮤니케이션 허브 — NestJS 서버(server) + Flutter 앱(app)",
  "scripts": {
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run start:dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "server:lint": "npm --prefix server run lint",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File server/scripts/db-setup-wsl.ps1",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File server/scripts/db-up.ps1",
    "db:down": "wsl --shutdown",
    "db:up:docker": "docker compose -f server/docker-compose.yml up -d",
    "db:down:docker": "docker compose -f server/docker-compose.yml down",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:studio": "npm --prefix server run prisma:studio",
    "db:seed": "npm --prefix server run seed",
    "check:realtime": "node server/scripts/check-realtime.mjs",
    "check:reactions": "node server/scripts/check-reactions.mjs",
    "check:threads": "node server/scripts/check-threads.mjs",
    "check:quotes": "node server/scripts/check-quotes.mjs",
    "check:mentions": "node server/scripts/check-mentions.mjs",
    "check:pins": "node server/scripts/check-pins.mjs",
    "check:attachments": "node server/scripts/check-attachments.mjs",
    "check:issues": "node server/scripts/check-issues.mjs",
    "check:repos": "node server/scripts/check-repos.mjs",
    "check:oauth": "node server/scripts/check-oauth.mjs",
    "check:migrations": "node server/scripts/check-migrations.mjs"
  }
}
