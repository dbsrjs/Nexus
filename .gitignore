# ---- dependencies ----
node_modules/

# ---- build output ----
dist/
build/
server/dist/

# ---- secrets / environment ----
.env
.env.local
.env.*.local
# 손으로 뜬 백업도 시크릿을 담는다 (server/.env.backup-before-oauth 등)
.env.backup*
**/.env.backup*
# keep .env.example (committed)

# ---- Flutter (app/) ----
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/**/Pods/
app/**/.gradle/
app/ios/Flutter/Flutter.framework/
app/ios/Flutter/Flutter.podspec
*.iml

# ---- 첨부 (개발용 로컬 디스크 드라이버) ----
# DB 와 같다 — PC 마다 따로고 git 으로 옮기지 않는다.
server/storage/

# ---- logs ----
*.log
npm-debug.log*
yarn-error.log*

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- misc ----
*.tsbuildinfo
coverage/

# ---- 디자인 캔버스 ----
# .dc.html 원본과 canvas.json 은 남긴다 — 다시 그릴 때 여기서 시작한다.
# 빌드 산출물만 뺀다: 에디터가 통째로 박혀 있어 2.3MB 다.
.design/*.html
!.design/*.dc.html
