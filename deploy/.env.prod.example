# 배포용 환경변수. `cp .env.prod.example .env` 후 채운다. .env 는 커밋되지 않는다.
#
# 이 파일 하나를 compose 가 두 번 쓴다 — ${...} 치환(POSTGRES_PASSWORD · TUNNEL_TOKEN)과
# 서버 컨테이너의 env_file. 서버 값의 뜻은 server/.env.example 에 있다.
#
# 무작위 값 만들기:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# **base64url 로 만든다.** POSTGRES_PASSWORD 는 DATABASE_URL 에 그대로 들어가 `/` · `@` 가
# 섞이면 주소가 깨진다.

# ── compose ────────────────────────────────────
POSTGRES_PASSWORD=
# Cloudflare 대시보드 → Zero Trust → Networks → Tunnels 에서 만든 터널의 토큰.
# 공개 호스트 이름의 서비스는 http://web:80 으로 둔다. --profile tunnel 일 때만 쓰인다.
TUNNEL_TOKEN=
# VM 안에서 curl 로 볼 때의 포트(127.0.0.1 에만 열린다).
HTTP_PORT=8080
# 비우면 시드가 임의 비밀번호를 만들어 한 번 찍는다.
SEED_PASSWORD=

# ── 서버: 시크릿 ────────────────────────────────
# 비면 부팅을 멈춘다(jwt.config.ts · oauth.config.ts).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32바이트 base64url: randomBytes(32). **잃으면 DB 의 GitHub 토큰을 못 푼다** — 백업과 함께 보관.
OAUTH_TOKEN_KEY=

# ── 서버: 주소 ──────────────────────────────────
# 웹과 API 가 한 오리진(nginx.conf)이라 브라우저 요청은 CORS 대상이 아니다. 그래도 같은 값을 둔다.
CORS_ORIGINS=https://nexus.example.com
# https 뒤이므로 true. false 면 리프레시 쿠키가 평문으로도 실린다.
COOKIE_SECURE=true
# GitHub 웹훅이 오는 주소 · OAuth 콜백. 둘 다 터널의 공개 주소다.
PUBLIC_BASE_URL=https://nexus.example.com
GITHUB_CALLBACK_URL=https://nexus.example.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 서버: 가입 ──────────────────────────────────
# 주소 하나당 한 시간에 가입 시도 몇 번. 비우면 10. 0 은 끔 — 공개 배포에서 끄지 않는다.
SIGNUP_LIMIT_PER_HOUR=

# ── 서버: 첨부 (Cloudflare R2) ──────────────────
# R2 버킷을 대시보드에서 만들고 **수명주기 규칙이 없는지** 확인한다(무기한 보관).
# 키는 그 버킷에만 Object Read & Write 를 준 API 토큰으로 발급한다.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://<계정 ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=nexus-attachments
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# ── 서버: AI ────────────────────────────────────
# 운영 provider 는 gemini 로 정했다(2026-10-07). 비우면 AI 만 503 이다.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# 인덱싱. VM 에 GPU 가 없어 local 은 느리다 — 비우면 인덱싱만 꺼진다.
EMBEDDING_PROVIDER=
