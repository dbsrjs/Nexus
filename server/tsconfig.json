{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // TypeScript 6 은 `types` 기본값이 빈 목록이라 @types/* 를 저절로 읽지 않는다.
    // multer 는 `Express.Multer.File` 전역 타입 때문에, jest 는 spec 의 전역 함수 때문에 둔다
    "types": ["node", "jest", "multer"]
  },
  "exclude": [
    "node_modules",
    "dist",

    // tsconfig.build.json 과 같은 목록. Redis 어댑터는 다중 인스턴스가 될 때 되살린다 (스펙 §6)
    "src/realtime/redis-io.adapter.ts"
  ]
}
