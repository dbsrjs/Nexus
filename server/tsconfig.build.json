{
  "extends": "./tsconfig.json",
  // TypeScript 6 은 rootDir 을 추정하지 않는다. 비우면 dist/main.js 가 아닌 곳에 떨어진다
  "compilerOptions": { "rootDir": "./src" },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "prisma/seed.ts",

    // 옛 단일 테넌트 모듈은 전부 다시 쓰거나 지웠다(2026-10-05 — notifications · gitlab 은
    // 18 · 20 단계가 새로 쓴다. 옛 소스는 git 이력에 있다).
    // Redis 어댑터는 다중 인스턴스가 될 때 되살린다 (스펙 §6)
    "src/realtime/redis-io.adapter.ts"
  ]
}
