# Nexus 서버 환경변수
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
# ⚠ 이 저장소는 공개된다. 여기에 실제 키를 절대 적지 말 것.
#   플레이스홀더는 일부러 "그대로 두면 부팅이 실패하는" 형태로 두었다.
#   change-me 류의 값을 두지 않는 이유는, 그대로 복사돼 배포되는 경로를
#   원천 차단하기 위해서다 (docs/백엔드-설계.md §6).

# ── 데이터베이스 ───────────────────────────────
# 로컬 개발은 docker-compose.yml 의 pgvector 컨테이너를 쓴다.
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# ── Redis (프레즌스 · Socket.IO 어댑터 · 큐) ────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────
# 필수. 미설정이면 서버가 부팅을 거부한다 (폴백 시크릿을 두지 않는다).
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 선택. 비우면 JWT_SECRET 을 재사용한다. 분리하면 액세스 토큰 유출 시
# 리프레시 토큰까지 위조되는 경로가 막힌다.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────
# Flutter 웹 배포 도메인을 쉼표로 구분해 나열한다. 네이티브 앱은 CORS 대상이 아니다.
# 비우면 브라우저 요청을 전부 거부한다 (무조건 허용하지 않는다).
CORS_ORIGINS=http://localhost:5173

# 리프레시 토큰 쿠키에 Secure 를 붙일지. https 배포에서는 true.
COOKIE_SECURE=false

# ── 오브젝트 스토리지 (S3 호환) ─────────────────
# 개발: MinIO 컨테이너 / 운영: Cloudflare R2 · S3
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=nexus-attachments
STORAGE_REGION=auto

# ── GitHub OAuth (저장소 연동 · 소셜 로그인) ────
# 저장소 단계에서 사용한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ── LLM · 임베딩 (AI 단계) ──────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# ── 서버 ───────────────────────────────────────
PORT=3000
