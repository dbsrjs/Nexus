# Nexus 서버 환경변수
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
# ⚠ 이 저장소는 공개된다. 여기에 실제 키를 절대 적지 말 것.
#   플레이스홀더는 일부러 "그대로 두면 부팅이 실패하는" 형태로 두었다.
#   change-me 류의 값을 두지 않는 이유는, 그대로 복사돼 배포되는 경로를
#   원천 차단하기 위해서다 (docs/백엔드-설계.md §6).

# ── 데이터베이스 ───────────────────────────────
# 로컬 개발은 docker-compose.yml 의 pgvector 컨테이너, 또는 WSL 안의 Postgres.
#
# ⚠ 호스트는 반드시 127.0.0.1 로 쓴다. `localhost` 는 Windows 에서 ::1(IPv6)로
#   먼저 해석되는데 WSL 포트 포워딩은 IPv4 만 동작해서 P1001(연결 불가)이 난다.
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus

# ── Redis (프레즌스 · Socket.IO 어댑터 · 큐) ────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────
# 필수. 미설정이면 서버가 부팅을 거부한다 (폴백 시크릿을 두지 않는다).
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 선택. 비우면 JWT_SECRET 을 재사용한다. 분리하면 액세스 토큰 유출 시
# 리프레시 토큰까지 위조되는 경로가 막힌다.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────
# Flutter 웹 배포 도메인을 쉼표로 구분해 나열한다. 네이티브 앱은 CORS 대상이 아니다.
# 비우면 브라우저 요청을 전부 거부한다 (무조건 허용하지 않는다).
CORS_ORIGINS=http://localhost:5173

# 리프레시 토큰 쿠키에 Secure 를 붙일지. https 배포에서는 true.
COOKIE_SECURE=false

# ── 첨부 스토리지 ───────────────────────────────
# local = 서버 옆 디렉터리에 그대로 둔다(개발). s3 = S3 호환(배포, 8단계 이후 구현).
#
# 어느 쪽이든 **첨부는 서버를 통해 스트리밍한다.** 서명 URL 을 발급하지 않으므로
# 드라이버를 바꿔도 클라이언트가 보는 주소(GET /api/spaces/:id/attachments/:id)는
# 그대로다. 서명 URL 은 SpaceGuard 를 지나지 않아 스페이스 밖에서도 열린다.
STORAGE_DRIVER=local

# local 드라이버의 저장 위치. 비우면 server/storage. git 에서 제외돼 있다.
STORAGE_LOCAL_DIR=

# s3 드라이버용 (운영: Cloudflare R2 · S3 / 배포 전 MinIO 로 한 번 검증)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=nexus-attachments
STORAGE_REGION=auto

# ── GitHub OAuth (저장소 연동 · 소셜 로그인) ────
# 저장소 단계에서 사용한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 브라우저가 돌아오는 주소다. 웹훅용 PUBLIC_BASE_URL 과 다르다 — 이쪽은 localhost 로 충분하다.
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# 토큰 암호화 키 (32바이트 base64url). 비우면 GitHub 연결만 503 이 된다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_TOKEN_KEY=

# 검증 전용. 비우면 진짜 GitHub 을 쓴다 — npm run check:oauth 가 가짜 서버를 물린다.
GITHUB_OAUTH_BASE=
GITHUB_API_BASE=

# ── 웹훅 자동 등록 (10-2b) ──────────────────────
# **GitHub 서버가 오는 주소**다. 위 GITHUB_CALLBACK_URL 과 다르다 —
# 콜백은 사람의 브라우저가 오므로 localhost 로 충분하지만 이쪽은 밖에서
# 닿아야 하므로 터널이어야 한다.
#   cloudflared tunnel --url http://localhost:3000
# 비워 두면 자동 등록만 400 이고 수동 등록은 그대로 된다.
#
# ⚠ 비워 두면 계약 검증(check:oauth · check:browse)이 준비 단계에서 중단된다.
#   그때는 아무 http 주소면 된다(가짜 GitHub 이 훅 URL 을 검사하지 않는다):
#     PUBLIC_BASE_URL=http://127.0.0.1:3000
PUBLIC_BASE_URL=

# ── LLM · 임베딩 (AI 단계) ──────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# ── 서버 ───────────────────────────────────────
PORT=3000
